// Prisma schema — Kodeza · 3M
// Executar `npm run pd` (migrate dev) após configurar DATABASE_URL, depois `npm run seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Site institucional (leads do formulário /contato) ----------

enum ServiceInterest {
  ESTRATEGIA
  CRIATIVIDADE
  TRAFEGO
  MIDIAS_SOCIAIS
  BRANDING
  OUTRO
  WEBSITE
  WEBAPP
  LANDING_PAGE
  IDENTIDADE_VISUAL
  REGISTO_EMPRESA
  ASSESSORIA_VISTO
  BILHETES
  ASSESSORIA_PASSAPORTE
}

// Cobrança única, ou recorrente (ex.: gestão mensal de redes sociais).
enum BillingType {
  UNICO
  RECORRENTE
}

enum LeadStatus {
  NOVO
  EM_CONTATO
  QUALIFICADO
  GANHO
  PERDIDO
}

model Lead {
  id        String          @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   ServiceInterest
  message   String
  status    LeadStatus      @default(NOVO)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([email])
  @@index([createdAt])
}

// ---------- Autenticação do painel administrativo ----------

enum Role {
  ADMIN
  EDITOR
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notificationReads NotificationRead[]
}

// Notificações lidas, por utilizador. As notificações em si são calculadas a partir
// das facturas e pedidos (ver lib/notifications.ts); aqui só se guarda "já li".
// `key` é estável, p. ex. "invoice-overdue:<id da factura>".
model NotificationRead {
  id      String   @id @default(cuid())
  adminId String
  key     String
  readAt  DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, key])
  @@index([adminId])
}

// ---------- CRM: clientes, pedidos/projetos e faturas ----------

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String? // opcional: só nome e telefone são obrigatórios
  phone     String?
  company   String?
  taxId     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@index([email])
  @@index([name])
}

enum ProjectStatus {
  BACKLOG
  EM_ANDAMENTO
  EM_REVISAO
  CONCLUIDO
  CANCELADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model Project {
  id          String          @id @default(cuid())
  title       String
  description String?
  service     ServiceInterest @default(OUTRO)
  status      ProjectStatus   @default(BACKLOG)
  priority    Priority        @default(MEDIA)
  value       Decimal         @db.Decimal(10, 2)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Detalhes específicos do serviço (visto, passaporte, bilhetes): país, requerentes, trajecto…
  // Estrutura validada em lib/service-details.ts.
  serviceDetails Json?

  // Cobrança recorrente: em cada `nextBillingDate` o sistema emite uma factura nova
  // (lib/recurring-billing.ts). Nos projectos recorrentes, `value` é o valor de cada cobrança.
  billingType       BillingType @default(UNICO)
  recurrenceMonths  Int? // 1 = mensal, 3 = trimestral, 6 = semestral, 12 = anual
  nextBillingDate   DateTime?
  recurrenceEndDate DateTime?
  paymentTermDays   Int         @default(5) // dias entre a emissão e o vencimento

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoices Invoice[]
  expenses Expense[]

  @@index([clientId])
  @@index([status])
  @@index([billingType, nextBillingDate])
}

enum InvoiceStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

// Faturas ficam presas a um Pedido (Project); o cliente é sempre acessível
// via invoice.project.client — uma única fonte de verdade para os números
// que alimentam a página /admin/financeiro (nada é duplicado/"sincronizado"
// manualmente, é a mesma tabela consultada de formas diferentes).
// Contador sequencial das facturas. O número nunca é reutilizado, mesmo que
// uma factura seja eliminada (a numeração fiscal não deve ter números repetidos).
model InvoiceCounter {
  id         Int @id
  lastNumber Int @default(0)
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDENTE)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Controlo de parcelas: recalculado automaticamente (lib/invoice-balance-server.ts)
  // sempre que uma factura do pedido é criada, editada, cancelada ou eliminada.
  installment        Int? // 1.ª, 2.ª, 3.ª factura do pedido
  projectTotal       Decimal? @db.Decimal(10, 2) // valor total do pedido
  previouslyInvoiced Decimal? @db.Decimal(10, 2) // facturado antes desta factura
  remaining          Decimal? @db.Decimal(10, 2) // valor em falta depois desta factura
  settlesProject     Boolean  @default(false) // "não falta mais nada" marcado manualmente
  recurringCycle     Int? // nº da cobrança, nas facturas geradas por um projecto recorrente

  // Onde o dinheiro entrou quando a factura foi paga.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([accountId])
  @@index([status])
  @@index([dueDate])
}


// ---------- Finanças: contas e despesas ----------

// Onde está o dinheiro: bancos, carteiras digitais (ex.: PayPay), caixa…
model Account {
  id             String   @id @default(cuid())
  name           String // descrição, ex.: "Conta BAI — Kodeza"
  bankName       String? // banco / tipo: BAI, BFA, PayPay, Caixa…
  accountNumber  String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2) // saldo ao começar a usar o sistema
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
  expenses Expense[]
}

enum ExpenseCategory {
  SALARIOS
  RENDA
  FERRAMENTAS
  MARKETING
  TRANSPORTE
  IMPOSTOS
  EQUIPAMENTO
  SERVICOS_TERCEIROS
  OUTROS
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  category    ExpenseCategory @default(OUTROS)
  supplier    String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // De que conta saiu o dinheiro, e (opcional) a que pedido se refere.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([accountId])
  @@index([projectId])
}
