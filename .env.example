# Copie para .env e preencha.

# Base de dados PostgreSQL
DATABASE_URL=

# Segredo da sessão do painel (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=

# URL pública do site (usada nos metadados e na partilha)
NEXT_PUBLIC_SITE_URL=https://www.3mvisa.site

# Opcional: credenciais da conta criada por `npm run seed`
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
