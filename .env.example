# Copie para .env e preencha.

# Base de dados PostgreSQL
DATABASE_URL=

# Segredo da sessão do painel (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=

# URL pública do site (usada nos metadados e na partilha)
NEXT_PUBLIC_SITE_URL=https://www.3mvisa.site

# Opcional: credenciais da conta criada por `npm run seed`
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Tempo real (Pusher Channels) — notificações instantâneas no painel.
# Sem estas variáveis o painel funciona na mesma, a actualizar de minuto a minuto.
# NEXT_PUBLIC_* ficam visíveis no browser (não são secretas). O SECRET nunca leva NEXT_PUBLIC.
PUSHER_APP_ID=2205475
NEXT_PUBLIC_PUSHER_KEY=dd4c922fb5ca17a96b4e
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
PUSHER_SECRET=
